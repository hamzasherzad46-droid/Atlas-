rules_version = '2';

// Atlas keeps one document per account, users/{uid}, with that student's progress (see
// src/lib/syncMerge.ts). Only the signed-in owner can read, write or delete it; nothing else exists.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.schema == 1
        && request.resource.data.keys().hasOnly(['schema', 'updatedAt', 'resetAt', 'records', 'cards', 'assessments', 'claimed', 'xp', 'days', 'profile']);
    }
  }
}
